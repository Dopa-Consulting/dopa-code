# =============================================================================
# Dopa Code - Variables de Entorno
# Copiar a .env y configurar con tus valores
# =============================================================================

# --- Core ---
DOPA_DATABASE_URL=sqlite+aiosqlite:///./dopa_code.db
DOPA_CODE_DUMMY=0
# DOPA_CODE_DUMMY=1  # Activar para desarrollo sin tocar repos reales

# --- OpenRouter (BYOK - el usuario paga sus tokens) ---
# Obten tu key en: https://openrouter.ai/keys
DOPA_OPENROUTER_API_KEY=sk-or-v1-...

# --- APIs directas (sin margen del 5% de OpenRouter) ---
# OpenAI: https://platform.openai.com/api-keys
DOPA_OPENAI_API_KEY=sk-...
# Anthropic: https://console.anthropic.com/
DOPA_ANTHROPIC_API_KEY=sk-ant-...
# DeepSeek: https://platform.deepseek.com/
DOPA_DEEPSEEK_API_KEY=sk-...
# Google AI: https://aistudio.google.com/apikey
DOPA_GOOGLE_API_KEY=AIza...
# Groq: https://console.groq.com/keys
DOPA_GROQ_API_KEY=gsk_...

# --- LLM Roles (modelos por defecto) ---
# Architect: planifica y disena (razonamiento pesado)
DOPA_ARCHITECT_MODEL=anthropic/claude-opus-4-8
# Executor: ejecuta cambios (rapido y barato)
DOPA_EXECUTOR_MODEL=deepseek/deepseek-chat
# QA: revisa diffs (puede ser Antigravity gratis)
DOPA_QA_MODEL=antigravity

# --- Antigravity (QA gratis, plan profesor) ---
DOPA_ANTIGRAVITY_API_KEY=

# --- Easypanel Deploy ---
# Token de deploy: Easypanel -> Project -> Settings -> Deploy Token
DOPA_EASYPANEL_DEPLOY_TOKEN=
DOPA_EASYPANEL_ENDPOINT=https://easypanel.io

# --- Seguridad ---
DOPA_JWT_SECRET=cambiar-por-valor-seguro-en-produccion
DOPA_ACCESS_TOKEN=cambiar-por-valor-seguro-en-produccion
DOPA_JWT_ALGORITHM=HS256
DOPA_JWT_EXPIRE_MINUTES=60
DOPA_BRIDGE_TOKEN=dopa-bridge-local-dev

# --- WebAuthn (Passkeys) ---
# No requiere configuracion adicional. Se registra desde la PWA.

# --- Voice (ElevenLabs — opcional) ---
DOPA_ELEVENLABS_API_KEY=
DOPA_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
DOPA_VOICE_ENABLED=0

# --- n8n (CI/CD) ---
# El VPS de n8n configura estas variables en sus propios workflows
# INTI_URL=https://dopa-code.local:8000
# GITHUB_TOKEN=ghp_...
# SLACK_WEBHOOK=https://hooks.slack.com/...
